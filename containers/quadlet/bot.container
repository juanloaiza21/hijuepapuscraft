[Unit]
Description=HijuepapusCraft Discord bot
Wants=socket-proxy.service
After=socket-proxy.service

[Container]
ContainerName=bot
# Image tag is bumped by editing this file (versioned pin).
Image=ghcr.io/juanloaiza21/hijuepapuscraft-bot:sha-9a0097d
Network=mcnet.network
EnvironmentFile=/opt/hijuepapuscraft/.env.bot

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
