# Values must be unquoted, with no spaces around '=' and no '#' inside
# values. This file is parsed by shell `source`, podman --env-file, and
# systemd EnvironmentFile, which do not all handle quoting the same way.

# ---- Discord bot ----
DISCORD_TOKEN=changeme
DISCORD_GUILD_ID=000000000000000000
DISCORD_ADMIN_ROLE_ID=000000000000000000
# Optional; role allowed to /whitelist remove; falls back to admin role when unset
DISCORD_REMOVER_ROLE_ID=000000000000000000
DISCORD_NOTIFY_CHANNEL_ID=000000000000000000
DOCKER_API_URL=http://socket-proxy:2375
RCON_ADDR=mc:25575
SERVER_ADDRESS=mc.hijuepapus.pro

# ---- Minecraft server ----
RCON_PASSWORD=changeme
MEMORY=6G
DIFFICULTY=hard

# ---- Images (bump deliberately, never latest) ----
MC_IMAGE=docker.io/itzg/minecraft-server:2026.7.2-java25
# PROXY_IMAGE and BOT_IMAGE below are documentation pointers only; the
# operative pins live in containers/quadlet/socket-proxy.container and
# containers/quadlet/bot.container. Edit those files to bump either image.
PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:3.4.3-r0-ls90
BOT_IMAGE=ghcr.io/juanloaiza21/hijuepapuscraft-bot:sha-790e867
BACKUP_IMAGE=ghcr.io/juanloaiza21/hijuepapuscraft-backup:sha-790e867

# ---- Backups (Cloudflare R2 via S3 API) ----
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/hijuepapus-backups
RESTIC_PASSWORD=changeme
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# ---- Host ----
TZ=America/Bogota
