# ---- Discord bot ----
DISCORD_TOKEN=changeme
DISCORD_GUILD_ID=000000000000000000
DISCORD_ADMIN_ROLE_ID=000000000000000000
DISCORD_NOTIFY_CHANNEL_ID=000000000000000000
DOCKER_API_URL=http://socket-proxy:2375
